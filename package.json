{
  "name": "@t3tools/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "dev:marketing": "vp run --filter @t3tools/marketing dev",
    "dev:desktop": "node scripts/dev-runner.ts dev:desktop",
    "desktop:backup": "node scripts/desktop-installation-state.ts backup",
    "desktop:restore": "node scripts/desktop-installation-state.ts restore",
    "desktop:reset": "node scripts/desktop-installation-state.ts reset",
    "study-buddy:ports": "node scripts/study-buddy-runner.ts ports",
    "study-buddy:dev": "node scripts/study-buddy-runner.ts dev",
    "study-buddy:dev:no-browser": "node scripts/study-buddy-runner.ts dev:no-browser",
    "study-buddy:app": "node scripts/study-buddy-runner.ts app",
    "study-buddy:audit": "node scripts/study-buddy-audit.ts",
    "moodle:agent": "node scripts/study-buddy-runner.ts moodle",
    "start": "vp run --filter t3 start",
    "start:desktop": "vp run --filter @t3tools/desktop start",
    "start:marketing": "vp run --filter @t3tools/marketing preview",
    "start:mock-update-server": "node scripts/mock-update-server.ts",
    "build": "vp run --filter './apps/*' --filter './packages/*' --filter './oxlint-plugin-t3code' --filter './scripts' build",
    "build:marketing": "vp run --filter @t3tools/marketing build",
    "build:desktop": "vp run --filter @t3tools/desktop --filter t3 build",
    "typecheck": "vp run -r --concurrency-limit 2 typecheck",
    "tc": "vp run -r --concurrency-limit 2 typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "lint:mobile": "node scripts/mobile-native-static-check.ts",
    "test": "vp run -r --concurrency-limit 2 test",
    "test:desktop-smoke": "vp run --filter @t3tools/desktop smoke-test",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "build:contracts": "vp run --filter @t3tools/contracts build",
    "dist:desktop:artifact": "node --experimental-strip-types scripts/build-desktop-artifact.ts",
    "dist:desktop:dmg": "node --experimental-strip-types scripts/build-desktop-artifact.ts --platform mac --target dmg",
    "dist:desktop:dmg:arm64": "node --experimental-strip-types scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "dist:desktop:dmg:x64": "node --experimental-strip-types scripts/build-desktop-artifact.ts --platform mac --target dmg --arch x64",
    "dist:desktop:linux": "node --experimental-strip-types scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "dist:desktop:win": "node --experimental-strip-types scripts/build-desktop-artifact.ts --platform win --target nsis",
    "dist:desktop:win:arm64": "node --experimental-strip-types scripts/build-desktop-artifact.ts --platform win --target nsis --arch arm64",
    "dist:desktop:win:x64": "node --experimental-strip-types scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64",
    "release:smoke": "node scripts/release-smoke.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .vite-plus apps/*/.vite-plus packages/*/.vite-plus",
    "sync:vscode-icons": "node scripts/sync-vscode-icons.mjs"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.28.6",
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "^1.63.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@voidzero-dev/vite-plus-test": "0.1.24",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  },
  "packageManager": "pnpm@10.24.0",
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}
